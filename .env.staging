# SIGPI Staging Environment
# Use: docker compose --env-file .env.staging up -d

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=staging-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=staging.sigpi.example.com
DJANGO_SETTINGS_MODULE=config.settings.base

# Database
POSTGRES_DB=sigpi_staging
POSTGRES_USER=sigpi
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_STAGING
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_APP_USER=sigpi_app
POSTGRES_APP_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_STAGING
POSTGRES_REPLICA_HOST=db-replica
POSTGRES_REPLICA_USER=sigpi_replicator
POSTGRES_REPLICA_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_STAGING

# Redis
REDIS_URL=redis://redis:6379/0

# OIDC/Keycloak
OIDC_RP_CLIENT_ID=sigpi-app-staging
OIDC_RP_CLIENT_SECRET=CHANGE_THIS_SECURE_CLIENT_SECRET_STAGING
OIDC_RP_SIGN_ALGO=RS256
OIDC_OP_AUTHORIZATION_ENDPOINT=https://keycloak.staging.sigpi.example.com/realms/sigpi/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=https://keycloak.staging.sigpi.example.com/realms/sigpi/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=https://keycloak.staging.sigpi.example.com/realms/sigpi/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=https://keycloak.staging.sigpi.example.com/realms/sigpi/protocol/openid-connect/certs
OIDC_OP_LOGOUT_ENDPOINT=https://keycloak.staging.sigpi.example.com/realms/sigpi/protocol/openid-connect/logout
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_STAGING
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://kc-db:5432/keycloak_staging
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_STAGING
KC_HOSTNAME=keycloak.staging.sigpi.example.com
KC_HTTP_ENABLED=false
KC_POSTGRES_DB=keycloak_staging
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_STAGING

# MinIO
MINIO_ENDPOINT=https://minio.staging.sigpi.example.com
MINIO_ACCESS_KEY=CHANGE_THIS_ACCESS_KEY_STAGING
MINIO_SECRET_KEY=CHANGE_THIS_SECRET_KEY_STAGING
MINIO_BUCKET_NAME=sigpi-documents-staging
MINIO_ROOT_USER=CHANGE_THIS_ACCESS_KEY_STAGING
MINIO_ROOT_PASSWORD=CHANGE_THIS_SECRET_KEY_STAGING

# Meilisearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=CHANGE_THIS_SECURE_MASTER_KEY_STAGING
MEILI_ENV=production
MEILI_MASTER_KEY=CHANGE_THIS_SECURE_MASTER_KEY_STAGING
MEILI_NO_ANALYTICS=true

# Frontend
NEXT_TELEMETRY_DISABLED=1
WATCHPACK_POLLING=false
NEXT_PUBLIC_API_URL=https://api.staging.sigpi.example.com

# Superset
SUPERSET_SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_STAGING
SUPERSET_LOAD_EXAMPLES=no
DATABASE_DB=sigpi_staging
DATABASE_HOST=db-replica
DATABASE_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_STAGING
DATABASE_PORT=5432
DATABASE_USER=sigpi_readonly

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
