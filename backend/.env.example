# SIGPI Backend Environment Variables
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.

# ─── Django Core ───
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ─── PostgreSQL ───
POSTGRES_DB=sigpi
POSTGRES_USER=sigpi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── OIDC / Keycloak ───
OIDC_RP_CLIENT_ID=sigpi-app
OIDC_RP_CLIENT_SECRET=change-me-client-secret
OIDC_OP_AUTHORIZATION_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/certs
OIDC_OP_LOGOUT_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/logout
OIDC_OP_ISSUER=http://keycloak:8080/realms/sigpi
OIDC_RENEW_ID_TOKEN_EXPIRY_SECONDS=3600
OIDC_REDIRECT_REQUIRE_HTTPS=False

# ─── Session / CSRF Security ───
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ─── Redis / Cache / Celery ───
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# ─── Meilisearch ───
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ─── MinIO / S3 ───
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sigpi-documents
MINIO_REGION=us-east-1
MINIO_PRESIGN_PUT_EXPIRY=1800
MINIO_PRESIGN_GET_EXPIRY=900

# ─── Login Redirects ───
LOGIN_REDIRECT_URL=/
LOGOUT_REDIRECT_URL=/auth/login/
