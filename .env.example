# SIGPI Environment Configuration Example
# Copy this file to .env.local, .env.staging, or .env.production

# ============================================================================
# Django Configuration
# ============================================================================
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-this-to-a-very-long-random-string-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.base

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
POSTGRES_DB=sigpi
POSTGRES_USER=sigpi
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# App user for RLS (Row Level Security)
POSTGRES_APP_USER=sigpi_app
POSTGRES_APP_PASSWORD=change-this-secure-password

# Database Replica (for read operations)
POSTGRES_REPLICA_HOST=db-replica
POSTGRES_REPLICA_USER=sigpi_replicator
POSTGRES_REPLICA_PASSWORD=change-this-secure-password

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://redis:6379/0

# ============================================================================
# OIDC/Keycloak Configuration
# ============================================================================
OIDC_RP_CLIENT_ID=sigpi-app
OIDC_RP_CLIENT_SECRET=change-this-secure-client-secret
OIDC_RP_SIGN_ALGO=RS256

# Keycloak Endpoints (adjust hostname based on environment)
OIDC_OP_AUTHORIZATION_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/certs
OIDC_OP_LOGOUT_ENDPOINT=http://keycloak:8080/realms/sigpi/protocol/openid-connect/logout

# Keycloak Admin
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-this-secure-password
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://kc-db:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-this-secure-password
KC_HOSTNAME=localhost
KC_HTTP_ENABLED=true

# Keycloak Database
KC_POSTGRES_DB=keycloak
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=change-this-secure-password

# ============================================================================
# MinIO Configuration (S3-compatible storage)
# ============================================================================
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change-this-access-key
MINIO_SECRET_KEY=change-this-secret-key
MINIO_BUCKET_NAME=sigpi-documents
MINIO_ROOT_USER=change-this-access-key
MINIO_ROOT_PASSWORD=change-this-secret-key

# ============================================================================
# Meilisearch Configuration
# ============================================================================
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=change-this-secure-master-key
MEILI_ENV=production
MEILI_MASTER_KEY=change-this-secure-master-key
MEILI_NO_ANALYTICS=true

# ============================================================================
# Frontend Configuration (Next.js)
# ============================================================================
NEXT_TELEMETRY_DISABLED=1
WATCHPACK_POLLING=true
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# Apache Superset Configuration
# ============================================================================
SUPERSET_SECRET_KEY=change-this-to-a-very-long-random-string
SUPERSET_LOAD_EXAMPLES=no

# Superset Database Connection (connects to read replica)
DATABASE_DB=sigpi
DATABASE_HOST=db-replica
DATABASE_PASSWORD=change-this-secure-password
DATABASE_PORT=5432
DATABASE_USER=sigpi_readonly

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================================
# Email Configuration (optional, for notifications)
# ============================================================================
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@example.com
