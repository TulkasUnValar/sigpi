# SIGPI Production Environment
# Use: docker compose --env-file .env.production up -d

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECURE_PRODUCTION_KEY
DJANGO_ALLOWED_HOSTS=sigpi.example.com,www.sigpi.example.com
DJANGO_SETTINGS_MODULE=config.settings.production

# Database
POSTGRES_DB=sigpi
POSTGRES_USER=sigpi
POSTGRES_PASSWORD=CHANGE_THIS_VERY_SECURE_PRODUCTION_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_APP_USER=sigpi_app
POSTGRES_APP_PASSWORD=CHANGE_THIS_VERY_SECURE_PRODUCTION_PASSWORD
POSTGRES_REPLICA_HOST=db-replica
POSTGRES_REPLICA_USER=sigpi_replicator
POSTGRES_REPLICA_PASSWORD=CHANGE_THIS_VERY_SECURE_PRODUCTION_PASSWORD

# Redis
REDIS_URL=redis://redis:6379/0

# OIDC/Keycloak
OIDC_RP_CLIENT_ID=sigpi-app
OIDC_RP_CLIENT_SECRET=CHANGE_THIS_VERY_SECURE_CLIENT_SECRET_PRODUCTION
OIDC_RP_SIGN_ALGO=RS256
OIDC_OP_AUTHORIZATION_ENDPOINT=https://keycloak.sigpi.example.com/realms/sigpi/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=https://keycloak.sigpi.example.com/realms/sigpi/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=https://keycloak.sigpi.example.com/realms/sigpi/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=https://keycloak.sigpi.example.com/realms/sigpi/protocol/openid-connect/certs
OIDC_OP_LOGOUT_ENDPOINT=https://keycloak.sigpi.example.com/realms/sigpi/protocol/openid-connect/logout
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_VERY_SECURE_PRODUCTION_PASSWORD
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://kc-db:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_THIS_VERY_SECURE_PRODUCTION_PASSWORD
KC_HOSTNAME=keycloak.sigpi.example.com
KC_HTTP_ENABLED=false
KC_POSTGRES_DB=keycloak
KC_POSTGRES_USER=keycloak
KC_POSTGRES_PASSWORD=CHANGE_THIS_VERY_SECURE_PRODUCTION_PASSWORD

# MinIO
MINIO_ENDPOINT=https://minio.sigpi.example.com
MINIO_ACCESS_KEY=CHANGE_THIS_VERY_SECURE_PRODUCTION_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_VERY_SECURE_PRODUCTION_SECRET_KEY
MINIO_BUCKET_NAME=sigpi-documents
MINIO_ROOT_USER=CHANGE_THIS_VERY_SECURE_PRODUCTION_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_THIS_VERY_SECURE_PRODUCTION_SECRET_KEY

# Meilisearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=CHANGE_THIS_VERY_SECURE_PRODUCTION_MASTER_KEY
MEILI_ENV=production
MEILI_MASTER_KEY=CHANGE_THIS_VERY_SECURE_PRODUCTION_MASTER_KEY
MEILI_NO_ANALYTICS=true

# Frontend
NEXT_TELEMETRY_DISABLED=1
WATCHPACK_POLLING=false
NEXT_PUBLIC_API_URL=https://api.sigpi.example.com

# Superset
SUPERSET_SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING_PRODUCTION
SUPERSET_LOAD_EXAMPLES=no
DATABASE_DB=sigpi
DATABASE_HOST=db-replica
DATABASE_PASSWORD=CHANGE_THIS_VERY_SECURE_PRODUCTION_PASSWORD
DATABASE_PORT=5432
DATABASE_USER=sigpi_readonly

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration (required for production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@sigpi.example.com
EMAIL_HOST_PASSWORD=CHANGE_THIS_EMAIL_PASSWORD
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@sigpi.example.com
